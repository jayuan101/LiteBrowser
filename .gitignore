# Python
__pycache__/
*.pyc

# Amp scratch area
.amp/

# Build output (PyInstaller)
build/
dist/

# Zero-byte junk files left behind by shell redirects (names like "{,", "999", "dict")
# are not tracked: only the paths below are versioned.
/*
!/.gitignore
!/main.py
!/README.md
!/LICENSE
!/SECURITY.md
!/config.json
!/blocklist.txt
!/browser/
!/scratch/
!/packaging/

# Screenshots from test runs are large and regenerated by scratch/drive.py
scratch/shots/

# Private, untracked additions
/browser/fable_local.py
/config.local.json
/scratch/local_tests/
